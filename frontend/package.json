{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:movil": "ng build --configuration production && cap sync android",
    "android:local": "ng build --configuration local && CAP_LOCAL=1 cap sync android && adb reverse tcp:8000 tcp:8000 && cd android && ./gradlew installDebug",
    "android:abrir": "cap open android",
    "android:apk": "npm run build:movil && cd android && gradlew assembleDebug",
    "assets:movil": "node resources/generar.mjs && capacitor-assets generate --android --iconBackgroundColor #2b4cff --splashBackgroundColor #2b4cff"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/forms": "~22.2.5",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "~22.2.5",
    "@angular/router": "~22.2.5",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/motion": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.5",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
